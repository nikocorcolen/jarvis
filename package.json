{
  "name": "friday-cli",
  "version": "0.1.0",
  "description": "Spec-driven development CLI: bootstraps .friday/, manages specs, validates traceability.",
  "type": "module",
  "bin": {
    "friday": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:tests": "tsc -p tsconfig.test.json",
    "dev": "tsc --watch",
    "test": "npm run build:tests && node --test dist-tests/tests/*.js",
    "clean": "rm -rf dist dist-tests",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "gray-matter": "^4.0.3",
    "kleur": "^4.1.5",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "spec-driven",
    "cli",
    "ai",
    "agents",
    "kiro",
    "requirements",
    "design"
  ],
  "license": "MIT"
}
